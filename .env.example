# Application Settings
APP_NAME=vAIdya
# DEBUG=True also serves the frontend from the backend at /
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
# REQUIRED in production (the app refuses to start without it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# File Upload Settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_AUDIO_FORMATS=.m4a,.wav,.mp3,.ogg,.webm,.mp4

# ML Model Settings
WHISPER_MODEL=Systran/faster-distil-whisper-large-v2
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_CHUNK_LENGTH_SECONDS=20

# Database
DATABASE_URL=sqlite:///./vaidya.db
# For PostgreSQL: postgresql://user:password@localhost/vaidya

# Paths
AUDIO_DIR=./audio
TRANSCRIPTS_DIR=./transcripts
FRONTEND_DIR=./frontend
